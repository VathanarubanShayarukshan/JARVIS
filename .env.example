# Copy to .env and adjust. Everything is optional.

# Port the web app + API listen on
PORT=8000
# Set to true to disable token auth entirely (LAN only — anyone can drive the
# agent, and the agent can run shell commands). Leave false for anything public.
OPEN_ACCESS=false

# Admin password for the built-in web UI / admin API.
# If empty, the web UI shows a first-run setup screen instead.
ADMIN_TOKEN=

# Folder the agent is allowed to read/write/edit/run commands in.
# If empty, uses DATA_DIR/workspace.
# WORKSPACE_DIR=

# Default model used when the client does not pick one.
# Leave empty to auto-pick from the first configured provider.
DEFAULT_MODEL=

# Optional: force a specific OpenAI-compatible provider (overrides auto-detect).
# PROVIDER_BASE_URL=http://api.example.com/v1
# PROVIDER_API_KEY=
# PROVIDER_MODELS=model-a,model-b

# Server-side data dir (SQLite DB + default workspace).
DATA_DIR=data

# Agent loop safety limits
MAX_TOOL_ITERATIONS=12
MAX_MESSAGES=60